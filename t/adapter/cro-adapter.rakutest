use v6.d;
use Test;
use MVC::Keayl::Adapter::Cro;
use Cro::HTTP::Request;
use Cro::HTTP::Response;
use Cro::HTTP::Client;
use ServerFixtures;
use MVC::Keayl::Notifications;
use MVC::Keayl::Request;

sub cro-adapter {
  MVC::Keayl::Adapter::Cro.new(:app(EchoEndpoint.new), :port(0))
}

sub cro-request(Str $method, Str $target, *@headers) {
  my $request = Cro::HTTP::Request.new(:$method, :$target);
  $request.append-header(.key, .value) for @headers;
  $request
}

# build-request translation

{
  my $request = cro-adapter.build-request(cro-request('GET', '/p?a=b'), Blob.new);
  is $request.method, 'GET', 'the Cro method is translated';
  is $request.path, '/p', 'the Cro target path is translated';
  is $request.query-string, 'a=b', 'the Cro query string is translated';
}

{
  my $request = cro-adapter.build-request(cro-request('GET', '/', 'Host' => 'h.com'), Blob.new);
  is $request.header('host'), 'h.com', 'Cro headers are translated';
}

{
  my $request = cro-adapter.build-request(cro-request('POST', '/'), 'body-bytes'.encode('utf-8'));
  is $request.body, 'body-bytes', 'the body blob is decoded into the request';
}

# fill-response translation

{
  my $adapter  = cro-adapter;
  my $cro-req  = cro-request('POST', '/echo');
  my $cro-res  = Cro::HTTP::Response.new(:request($cro-req));

  $adapter.fill-response($cro-req, 'hi'.encode('utf-8'), $cro-res);

  is $cro-res.status, 200, 'fill-response copies the status onto the Cro response';
  is $cro-res.header('X-Method'), 'POST', 'fill-response copies headers onto the Cro response';
  is (await $cro-res.body-blob).decode('utf-8'), 'hi', 'fill-response copies the body onto the Cro response';
}

{
  my $adapter  = cro-adapter;
  my $cro-req  = cro-request('GET', '/');
  my $cro-res  = Cro::HTTP::Response.new(:request($cro-req));

  $adapter.fill-response($cro-req, Blob.new, $cro-res);

  nok $cro-res.header('Content-Length').defined,
    'fill-response leaves Content-Length to Cro';
}

# integration: a real round-trip over a socket

{
  my $port    = free-port();
  my $adapter = MVC::Keayl::Adapter::Cro.new(:app(EchoEndpoint.new), :host('127.0.0.1'), :$port);

  $adapter.start;
  LEAVE $adapter.stop;

  my $response = await Cro::HTTP::Client.post(
    "http://127.0.0.1:$port/echo?x=9",
    body => 'payload'.encode('utf-8'),
  );

  is $response.status, 200, 'the served response carries the status';
  is $response.header('X-Method'), 'POST', 'the served request preserves the method';
  is $response.header('X-Path'), '/echo', 'the served request preserves the path';
  is $response.header('X-Remote-IP'), '127.0.0.1', 'the served request carries the client address';
  is (await $response.body-text), 'payload', 'the served response carries the body';
}

# request log

sub request-log-dir(Str:D $label --> IO::Path) {
  my $dir = $*TMPDIR.add("keayl-request-log-t-$label-$*PID");
  $dir.mkdir;
  $dir
}

{
  temp %*ENV<KEAYL_REQUEST_LOG> = '/var/log/keayl';

  is cro-adapter.request-log-dir, '/var/log/keayl', 'the request log directory comes from KEAYL_REQUEST_LOG';
}

{
  my $adapter = MVC::Keayl::Adapter::Cro.new(:app(EchoEndpoint.new), :port(0), :request-log-dir(Nil));

  $adapter.log-request-event(cro-request('GET', '/'), 'body');

  nok $*TMPDIR.add("requests-{$*PID}.log").e, 'no log file is written without a request log directory';
}

{
  my $dir     = request-log-dir('unconnected');
  my $adapter = MVC::Keayl::Adapter::Cro.new(:app(EchoEndpoint.new), :port(4321), :request-log-dir($dir.Str));

  $adapter.log-request-event(cro-request('GET', '/'), 'body');

  like $dir.add("requests-{$*PID}.log").slurp,
    /^ \d**4 '-' \d\d '-' \d\d 'T' \d\d ':' \d\d ':' \d\d '.' \d**3 'Z port=4321 peer=- body' \n $/,
    'an event for a request with no connection records the time, server port, a placeholder peer port, and the event';
}

{
  my $dir     = request-log-dir('served');
  my $port    = free-port();
  my $adapter = MVC::Keayl::Adapter::Cro.new(:app(EchoEndpoint.new), :host('127.0.0.1'), :$port, :request-log-dir($dir.Str));

  $adapter.start;
  await (await Cro::HTTP::Client.post("http://127.0.0.1:$port/echo?x=9", body => 'payload'.encode('utf-8'))).body-text;
  $adapter.stop;

  my @lines = $dir.add("requests-{$*PID}.log").lines;

  is-deeply @lines.map(*.split(' ', 4)[3]).List, ('received POST /echo?x=9', 'body', 'called 200', 'emitted'),
    'a served request records received, body, called, and emitted in order';
  is @lines.grep(/" port=$port peer=" \d+ ' '/).elems, 4, 'each served event records the server and peer ports';
}

# request log of dispatch, render, and SQL events

sub request-log-events(IO::Path:D $dir --> List) {
  $dir.add("requests-{$*PID}.log").lines.map({ .split(' ', 4)[3].subst(/'duration=' \S+/, 'duration=D') }).List
}

sub logging-adapter(Str:D $label, $app --> MVC::Keayl::Adapter::Cro) {
  MVC::Keayl::Adapter::Cro.new(:$app, :port(4321), :request-log-dir(request-log-dir($label).Str))
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = logging-adapter('instrumented', InstrumentedEndpoint.new);

  $adapter.subscribe-request-log;
  $adapter.fill-response(cro-request('GET', '/deals/2'), Blob.new, Cro::HTTP::Response.new);
  $adapter.unsubscribe-request-log;

  is-deeply request-log-events($adapter.request-log-dir.IO), (
    'dispatch.keayl.start controller=deals action=show',
    'render.keayl.start kind=template name=deals/show',
    'sql.active_record.start name=SELECT sql=SELECT deals.id, deals.name, deals.amount, deals.stage, deals.created_at FROM de',
    'sql.active_record name=SELECT duration=D sql=SELECT deals.id, deals.name, deals.amount, deals.stage, deals.created_at FROM de',
    'render.keayl kind=template name=deals/show duration=D',
    'dispatch.keayl controller=deals action=show duration=D',
    'called 200',
  ), 'a dispatched request records a start line and an end line with the duration for each step';
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = logging-adapter('subscribed-twice', InstrumentedEndpoint.new);

  $adapter.subscribe-request-log;
  $adapter.subscribe-request-log;
  $adapter.fill-response(cro-request('GET', '/deals/2'), Blob.new, Cro::HTTP::Response.new);
  $adapter.unsubscribe-request-log;

  is request-log-events($adapter.request-log-dir.IO).elems, 7, 'an adapter subscribed twice records each event once';
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = logging-adapter('failing-dispatch', FailingDispatchEndpoint.new);

  $adapter.subscribe-request-log;
  try $adapter.fill-response(cro-request('GET', '/deals/2'), Blob.new, Cro::HTTP::Response.new);
  $adapter.unsubscribe-request-log;

  is request-log-events($adapter.request-log-dir.IO)[1], 'dispatch.keayl controller=deals action=show duration=D exception=X::AdHoc',
    'a dispatch that dies records the exception type on the end line';
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = logging-adapter('unsubscribed', InstrumentedEndpoint.new);

  $adapter.subscribe-request-log;
  $adapter.unsubscribe-request-log;
  $adapter.fill-response(cro-request('GET', '/deals/2'), Blob.new, Cro::HTTP::Response.new);

  is-deeply request-log-events($adapter.request-log-dir.IO), ('called 200',), 'an adapter that has unsubscribed records only the called line';
}

{
  MVC::Keayl::Notifications.reset;

  my $serving-adapter = logging-adapter('serving-adapter', InstrumentedEndpoint.new);
  my $idle-adapter    = logging-adapter('idle-adapter', InstrumentedEndpoint.new);

  $serving-adapter.subscribe-request-log;
  $idle-adapter.subscribe-request-log;
  $serving-adapter.fill-response(cro-request('GET', '/deals/2'), Blob.new, Cro::HTTP::Response.new);
  $serving-adapter.unsubscribe-request-log;
  $idle-adapter.unsubscribe-request-log;

  nok $idle-adapter.request-log-dir.IO.add("requests-{$*PID}.log").e, 'events are recorded only in the log of the adapter serving the request';
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = logging-adapter('outside-request', InstrumentedEndpoint.new);

  $adapter.subscribe-request-log;
  InstrumentedEndpoint.new.call(MVC::Keayl::Request.new(:method<GET>, :target</deals/2>));
  $adapter.unsubscribe-request-log;

  nok $adapter.request-log-dir.IO.add("requests-{$*PID}.log").e, 'an event outside any request writes no log file';
}

{
  MVC::Keayl::Notifications.reset;

  my $adapter = MVC::Keayl::Adapter::Cro.new(:app(InstrumentedEndpoint.new), :port(4321), :request-log-dir(Nil));

  $adapter.subscribe-request-log;

  nok MVC::Keayl::Notifications.has-subscribers('dispatch.keayl'), 'an adapter with no request log directory subscribes to no events';
}

done-testing;

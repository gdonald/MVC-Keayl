use v6.d;
use lib 'lib';
use Test;
use JSON::Fast;
use MIME::Base64;
use Digest::HMAC;
use Digest::SHA1::Native;
use MVC::Keayl::Request;
use MVC::Keayl::Parameters;
use MVC::Keayl::Routing;
use MVC::Keayl::Dispatcher;
use MVC::Keayl::TestSupport;
use MVC::Keayl::Storage;
use MVC::Keayl::Storage::Service;
use MVC::Keayl::Storage::Attached;
use MVC::Keayl::Storage::Serving;

my $temp-counter = 0;

sub temp-root(--> IO::Path) {
  $*TMPDIR.add('keayl-serving-' ~ $*PID ~ '-' ~ $temp-counter++)
}

sub cleanup(IO::Path $root) {
  return unless $root.e;
  for $root.dir -> $entry {
    $entry.f ?? $entry.unlink !! cleanup($entry);
  }
  $root.rmdir;
}

sub make-blob(Str $body, Str $filename, Str $content-type) {
  my $blob = MVC::Keayl::Storage::Blob.build($body, :$filename, :$content-type);
  storage-repository.create-blob($blob);
  storage-service.upload($blob.key, $body);
  $blob
}

sub params(%data) {
  MVC::Keayl::Parameters.new(%data)
}

class ServingFakeClient {
  has %.store;
  method upload($key, $data, *%) { %!store{$key} = $data }
  method download($key)          { %!store{$key} }
  method delete($key)            { %!store{$key}:delete }
  method exist($key)             { %!store{$key}:exists }
  method url($key, *%)           { "https://cdn.test/$key" }
}

sub storage-session(--> IntegrationSession) {
  my $router = routes { storage-routes };
  IntegrationSession.new(app => MVC::Keayl::Dispatcher.new(:$router, controllers => storage-controllers.Array))
}

# signed serving paths

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $blob = make-blob('content', 'file.txt', 'text/plain');

  my $redirect = blob-serving-path($blob);
  my $proxy    = blob-serving-path($blob, :proxy);

  ok $redirect.starts-with('/keayl/blobs/redirect/'), 'a redirect path uses the redirect route';
  ok $proxy.starts-with('/keayl/blobs/proxy/'), 'a proxy path uses the proxy route';
  ok $redirect.ends-with('/file.txt'), 'the serving path ends with the filename';

  reset-storage;
  cleanup($root);
}

# redirect controller

{
  reset-storage;
  set-storage-service(ExternalService.new(client => ServingFakeClient.new));

  my $blob   = make-blob('redirect-me', 'r.txt', 'text/plain');
  my $signed = storage-verifier.generate($blob.id, purpose => 'blob');

  my $response = MVC::Keayl::Storage::Serving::RedirectController.new(
    params => params({ signed_id => $signed }),
  ).dispatch('show');

  is $response.status, 302, 'the redirect controller issues a redirect';
  is $response.header('Location'), 'https://cdn.test/' ~ $blob.key, 'the redirect controller points at the service url';

  reset-storage;
}

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $blob   = make-blob('served-from-disk', 'r.txt', 'text/plain');
  my $signed = storage-verifier.generate($blob.id, purpose => 'blob');

  my $response = MVC::Keayl::Storage::Serving::RedirectController.new(
    params => params({ signed_id => $signed }),
  ).dispatch('show');

  is $response.status, 200, 'the redirect controller streams a disk blob instead of redirecting';
  is $response.body, 'served-from-disk', 'the redirect controller responds with the disk blob bytes';

  reset-storage;
  cleanup($root);
}

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $blob   = make-blob('hyphenated', 'h.txt', 'text/plain');
  my $signed = storage-verifier.generate($blob.id, purpose => 'blob');

  my $response = MVC::Keayl::Storage::Serving::RedirectController.new(
    params => params({ signed-id => $signed }),
  ).dispatch('show');

  is $response.body, 'hyphenated', 'the redirect controller still finds the blob under the hyphenated signed id name';

  reset-storage;
  cleanup($root);
}

{
  reset-storage;
  set-storage-service(DiskService.new(root => temp-root));

  my $response = MVC::Keayl::Storage::Serving::RedirectController.new(
    params => params({ signed_id => 'tampered--00' }),
  ).dispatch('show');

  is $response.status, 404, 'a tampered signed id is not found';

  reset-storage;
}

# proxy controller

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $blob   = make-blob('proxy-bytes', 'p.png', 'image/png');
  my $signed = storage-verifier.generate($blob.id, purpose => 'blob');

  my $response = MVC::Keayl::Storage::Serving::ProxyController.new(
    params => params({ signed_id => $signed }),
  ).dispatch('show');

  is $response.body, 'proxy-bytes', 'the proxy controller streams the blob bytes';
  is $response.header('content-type'), 'image/png', 'the proxy controller sets the blob content type';
  is $response.header('Content-Disposition'), 'inline; filename="p.png"', 'the proxy controller defaults to inline disposition';

  reset-storage;
  cleanup($root);
}

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $blob   = make-blob('attach-me', 'd.txt', 'text/plain');
  my $signed = storage-verifier.generate($blob.id, purpose => 'blob');

  my $response = MVC::Keayl::Storage::Serving::ProxyController.new(
    params => params({ signed_id => $signed, disposition => 'attachment' }),
  ).dispatch('show');

  is $response.header('Content-Disposition'), 'attachment; filename="d.txt"', 'the proxy controller honors an attachment disposition';

  reset-storage;
  cleanup($root);
}

# expiring signed urls

{
  reset-storage;
  my $root = temp-root;
  my $time = 1000;
  set-storage-service(DiskService.new(:$root));

  my $blob     = make-blob('expiring', 'e.txt', 'text/plain');
  my $verifier = MVC::Keayl::Storage::Verifier.new(secret => 'keayl-storage', clock => sub { $time });
  my $signed   = $verifier.generate($blob.id, purpose => 'blob', expires-in => 60);

  is $verifier.verify($signed, purpose => 'blob'), $blob.id, 'a signed url verifies before expiry';

  $time = 1100;
  nok $verifier.verify($signed, purpose => 'blob').defined, 'a signed url stops verifying after expiry';

  reset-storage;
  cleanup($root);
}

# signed ids

{
  reset-storage;

  my $data   = '??????~~~~~~';
  my $signed = storage-verifier.generate($data, purpose => 'blob');

  nok $signed.contains(any('/', '+', '=')), 'a signed id leaves out the characters that would split or alter a path segment';
  is storage-verifier.verify($signed, purpose => 'blob'), $data, 'a signed id verifies back to its data';

  my $payload = MIME::Base64.encode-str(to-json({ :$data, purpose => 'blob' }, :!pretty), :oneline);
  my $legacy  = $payload ~ '--' ~ hmac-hex('keayl-storage', $payload, &sha1);

  is storage-verifier.verify($legacy, purpose => 'blob'), $data, 'a signed id issued with standard Base64 still verifies';
}

# storage routes

{
  reset-storage;
  my $root = temp-root;
  set-storage-service(DiskService.new(:$root));

  my $session = storage-session;
  my $blob    = make-blob('routed-bytes', 'avatar.png', 'image/png');

  is $session.get(blob-serving-path($blob, :proxy)).body, 'routed-bytes', 'storage routes serve a proxy path built by blob-serving-path';
  is $session.get(blob-serving-path($blob)).body, 'routed-bytes', 'storage routes serve a redirect path built by blob-serving-path';

  my $created = $session.post('/keayl/direct-uploads',
    body    => 'filename=a.txt&byte_size=3&checksum=abc',
    headers => %( 'Content-Type' => 'application/x-www-form-urlencoded' ));

  is $created.status, 201, 'storage routes create a blob for a direct upload';

  my $key = generate-key;
  $session.put(upload-path($key), body => 'uploaded');

  is storage-service.download($key).decode, 'uploaded', 'storage routes store bytes uploaded to a direct upload url';

  reset-storage;
  cleanup($root);
}

done-testing;

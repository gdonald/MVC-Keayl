use v6.d;
use lib 'lib';
use lib 'specs/lib';
use Test;
use MVC::Keayl::Application;
use MVC::Keayl::Config;
use MVC::Keayl::Credentials;
use CLIFixtures;

sub app-in(IO::Path $root, Str $environment, *%options --> MVC::Keayl::Application) {
  MVC::Keayl::Application.new(:$root, config => MVC::Keayl::Config.new(:$environment), |%options)
}

sub credentials-root(--> IO::Path) {
  my $root       = temp-dir('secret-key-base-credentials-t');
  my $master-key = generate-master-key();

  write-file($root.add('config/master.key'), $master-key);
  write-file($root.add('config/credentials.yml.enc'), encrypt-content("secret-key-base: from-credentials\n", $master-key));

  $root
}

# without credentials

{
  my $root = temp-dir('secret-key-base-empty-t');

  is app-in($root, 'development').boot.controller-options<secret>, 'keayl-development-secret-key-base',
    'development sessions are signed with a fixed development secret';

  is app-in($root, 'test').boot.controller-options<secret>, 'keayl-development-secret-key-base',
    'test sessions are signed with a fixed development secret';

  dies-ok { app-in($root, 'production').boot }, 'an application refuses to boot in production';
}

# with credentials

{
  my $root = credentials-root;

  is app-in($root, 'development').boot.controller-options<secret>, 'from-credentials',
    'development sessions are signed with the credentials secret';

  is app-in($root, 'production').boot.controller-options<secret>, 'from-credentials',
    'production sessions are signed with the credentials secret';

  is app-in($root, 'production', controller-options => %( secret => 'explicit' )).boot.controller-options<secret>, 'explicit',
    'a secret passed in the controller options is kept';
}

done-testing;
